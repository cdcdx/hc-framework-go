      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [{
        "expr": "sum(rate(http_server_requests_code_total{job=\"hc-server\",code=~\"4..|5..\"}[1m])) / clamp_min(sum(rate(http_server_requests_code_total{job=\"hc-server\"}[1m])), 1e-9) * 100",
        "legendFormat": "错误率 %", "refId": "A"
      }],
      "title": "HTTP 错误率 (4xx+5xx)",
      "type": "timeseries"
    },
    {
