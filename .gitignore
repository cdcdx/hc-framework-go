# ============================================
# .gitignore
# ============================================

# 编译产物
/bin/
/dist/
/build/
*.exe
*.exe~
*.dll
*.so
*.dylib
__debug_bin*

# 测试覆盖率
coverage.html
coverage.out
*.out
*.test
*.prof

# 依赖
vendor/

# 数据文件
backup/
data/
*.db
*.db-shm
*.db-wal

# 日志
logs/
*.log

# 临时文件
tmp/
temp/
*.tmp

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

.reasonix/
reasonix.toml
.golangci.yml

# 环境变量
.env
.env.local
.env.production
.env.*
go.sum

# 死信队列本地持久化
dlq/

# Swagger 文档生成目录（由 `make generate` / `swag init` 生成，纯产物、非编译依赖，保持忽略）
swagger/
!docs/.gitkeep

# 密钥文件
*.pem
*.key
*.p12
*.pfx

# 注意：不要使用裸的 `server` 忽略规则，它会误伤名为 server 的源码目录。
# 如需忽略某 server 二进制产物，请使用具体路径（如 /bin/server）。
# 例外：保留 app/rpc/server 源码目录可被跟踪
!app/rpc/server/

# 本地真实配置副本/备份（含密钥，切勿提交）
.backup/
config/server.yaml
config/server.mysql.yaml

# K8s Secret（生产环境的实际密钥文件）
deployments/secret-prod.yaml
