syntax = "v1"

// ============================================================
// HC Framework 网关 API 描述（go-zero rest）
// 路由契约与 gin 版保持完全一致（含路径与请求字段）。
// 中间件分组：
//   - 公开组：/health /ready /captcha/config /auth/refresh
//   - 防水墙组：/auth/register /auth/login（SecurityIPLimit → Captcha）
//   - OAuth 组：/auth/google（无需验证码）
//   - JwtAuth 组：其余业务路由（网关校验 JWT 并注入 user_id）
// ============================================================

type (
	RegisterReq {
		Email    string `json:"email"`
		Password string `json:"password"`
		Username string `json:"username,optional"`
	}

	LoginReq {
		Email    string `json:"email"`
		Password string `json:"password"`
	}

	GoogleOAuthReq {
		Code string `json:"code"`
	}

	RefreshTokenReq {
		RefreshToken string `json:"refresh_token"`
	}

	ChangePasswordReq {
		OldPassword string `json:"old_password"`
		NewPassword string `json:"new_password"`
	}

	UpdateProfileReq {
		Username  string `json:"username,optional"`
		AvatarURL string `json:"avatar,optional"`
	}

	IdleStartReq {
		DeviceID string `json:"device_id"`
	}

	IdleHeartbeatReq {
		DeviceID string `json:"device_id"`
	}

	IdleStopDeviceReq {
		DeviceID string `json:"device_id"`
	}

	IdleRecordsReq {
		Cursor int64 `form:"cursor,optional"`
		Limit  int   `form:"limit,default=20,optional"`
	}

	TaskClaimReq {
		ID int64 `path:"id"`
	}

	ShopItemsReq {
		Cursor   int64  `form:"cursor,optional"`
		Limit    int    `form:"limit,default=20,optional"`
		Category string `form:"category,optional"`
	}

	ShopRedeemReq {
		ItemID   int64 `json:"item_id"`
		Quantity int32 `json:"quantity,optional"`
	}

	ShopOrdersReq {
		Cursor int64 `form:"cursor,optional"`
		Limit  int   `form:"limit,default=20,optional"`
	}

	ShopOrderDetailReq {
		ID int64 `path:"id"`
	}

	FlashActivitiesReq {
		Limit int `form:"limit,default=20,optional"`
	}

	FlashRedeemReq {
		ActivityID int64 `json:"activity_id"`
	}
)

// ---------- 公开系统接口 ----------
service gateway-api {
	@handler Health
	get /health

	@handler Ready
	get /ready

	@handler CaptchaConfig
	get /api/v1/captcha/config

	@handler RefreshToken
	post /api/v1/auth/refresh (RefreshTokenReq)
}

// ---------- 防水墙组（注册/登录：IP 限频 → 验证码） ----------
@server (
	middleware: SecurityIPLimit, Captcha
)
service gateway-api {
	@handler Register
	post /api/v1/auth/register (RegisterReq)

	@handler Login
	post /api/v1/auth/login (LoginReq)
}

// ---------- Google OAuth（无验证码） ----------
service gateway-api {
	@handler GoogleOAuth
	post /api/v1/auth/google (GoogleOAuthReq)
}

// ---------- 需鉴权业务路由 ----------
@server (
	middleware: JwtAuth
)
service gateway-api {
	@handler ChangePassword
	put /api/v1/user/password (ChangePasswordReq)

	@handler GetProfile
	get /api/v1/user/profile

	@handler UpdateProfile
	put /api/v1/user/profile (UpdateProfileReq)

	@handler GetPoints
	get /api/v1/user/points

	@handler IdleStart
	post /api/v1/idle/start (IdleStartReq)

	@handler IdleHeartbeat
	post /api/v1/idle/heartbeat (IdleHeartbeatReq)

	@handler IdleStop
	post /api/v1/idle/stop

	@handler IdleStopDevice
	post /api/v1/idle/stop-device (IdleStopDeviceReq)

	@handler IdleStatus
	get /api/v1/idle/status

	@handler IdleRecords
	get /api/v1/idle/records (IdleRecordsReq)

	@handler TaskList
	get /api/v1/tasks

	@handler TaskProgress
	get /api/v1/tasks/progress

	@handler TaskClaim
	post /api/v1/tasks/:id/claim (TaskClaimReq)

	@handler ShopItems
	get /api/v1/shop/items (ShopItemsReq)

	@handler ShopRedeem
	post /api/v1/shop/redeem (ShopRedeemReq)

	@handler ShopOrders
	get /api/v1/shop/orders (ShopOrdersReq)

	@handler ShopOrderDetail
	get /api/v1/shop/orders/:id (ShopOrderDetailReq)

	@handler ShopFlashActivities
	get /api/v1/shop/flash/activities (FlashActivitiesReq)

	@handler ShopFlashRedeem
	post /api/v1/shop/flash/redeem (FlashRedeemReq)
}
